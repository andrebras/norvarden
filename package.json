{
  "name": "norvarden",
  "version": "1.0.0",
  "private": true,
  "description": "Norvarden company website and visual identity",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "check": "node --check dist/app.js && node scripts/check.mjs",
    "format": "prettier --write .",
    "lint": "prettier --check . && html-validate dist/*.html && stylelint \"dist/**/*.css\" && eslint .",
    "test": "npm run lint && npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "html-validate": "^10.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
