{
  "name": "norvarden",
  "version": "1.0.0",
  "private": true,
  "description": "Norvarden company website and visual identity",
  "type": "module",
  "engines": {
    "node": "^22.16.0 || >=24"
  },
  "scripts": {
    "dev": "npm run build && node scripts/serve.mjs",
    "start": "npm run build && node scripts/serve.mjs",
    "check": "node --check dist/app.js && node scripts/check.mjs",
    "format": "prettier --write .",
    "lint": "prettier --check . && html-validate dist/*.html && stylelint \"dist/**/*.css\" && eslint .",
    "test": "npm run build && npm run lint && npm run check",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@appsignal/javascript": "^1.6.1",
    "@appsignal/plugin-window-events": "^1.0.26",
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "html-validate": "^11.16.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
